{
  "name": "pbm-automation",
  "version": "1.0.0",
  "description": "Production-ready Playwright + TypeScript automation framework for the PBM (Pharmacy Benefit Management System) application.",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:chromium": "cross-env BROWSER=chromium playwright test",
    "test:firefox": "cross-env BROWSER=firefox playwright test",
    "test:webkit": "cross-env BROWSER=webkit playwright test",
    "test:chrome": "cross-env BROWSER=chrome playwright test",
    "test:edge": "cross-env BROWSER=edge playwright test",
    "report": "playwright show-report",
    "report:file": "node scripts/generateReport.js",
    "report:email": "node scripts/emailReport.js",
    "codegen": "playwright codegen %BASE_URL%",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && node scripts/checkLocators.js",
    "install:browsers": "playwright install",
    "lint:locators": "node scripts/checkLocators.js",
    "report:failures": "node scripts/classifyFailures.js",
    "report:status": "node scripts/classifyFailures.js",
    "report:doc": "node scripts/buildReport.js"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "pbm",
    "qa"
  ],
  "author": "Neorx QA",
  "license": "UNLICENSED",
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.0",
    "@types/nodemailer": "^8.0.1",
    "adm-zip": "^0.6.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "nodemailer": "^9.0.5",
    "typescript": "^5.6.0"
  }
}
