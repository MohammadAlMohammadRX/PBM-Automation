# =============================================================================
# PBM Automation Framework - Environment Configuration
# Copy this file to ".env" and fill in real values. Never commit the real ".env".
# =============================================================================

# ---- Application ------------------------------------------------------------
# Base URL of the PBM application under test
BASE_URL=http://20.75.201.176

# ---- Authentication -----------------------------------------------------------
# Admin credentials used by the one-time authentication fixture/global setup.
# These are QA credentials only - never use production secrets here.
ADMIN_USERNAME=careconnect
ADMIN_PASSWORD=Admin@123

# ---- Browser configuration ---------------------------------------------------
# One of: chromium | chrome | edge | firefox | webkit
BROWSER=chromium
# true = run without a visible browser window, false = headed
HEADLESS=true
# Playwright slowMo in milliseconds (0 = disabled). Useful for local debugging.
SLOW_MO=0

# ---- Timeouts (milliseconds) --------------------------------------------------
DEFAULT_TIMEOUT=30000
NAVIGATION_TIMEOUT=45000
ACTION_TIMEOUT=15000
EXPECT_TIMEOUT=10000

# ---- Execution -----------------------------------------------------------------
# Number of parallel workers. Leave empty to let Playwright decide.
WORKERS=
# Number of automatic retries for failed tests (recommended: 1-2 on CI, 0 locally)
RETRIES=0

# ---- Failure artifact storage (MUST stay outside the project directory) -------
# Windows example: C:\AutomationArtifacts\PBM\FailedScreenshots
# macOS/Linux example: /Users/me/AutomationArtifacts/PBM/FailedScreenshots
# If left empty, the framework defaults to a folder one level ABOVE the project root.
FAILED_SCREENSHOTS_PATH=C:\AutomationArtifacts\PBM\FailedScreenshots

# ---- Logging --------------------------------------------------------------------
# One of: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO
